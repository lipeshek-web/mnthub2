import { PrismaClient } from '@prisma/client'
const db = new PrismaClient()
const mentors = await db.mentorProfile.findMany({ include: { user: true, _count: { select: { courses: true, libraryItems: true } } } })
console.log('MENTORS:', mentors.length)
for (const m of mentors) console.log('-', m.user.name, '|', m.user.email, '| courses:', m._count.courses, '| lib:', m._count.libraryItems)
const cats = await db.course.groupBy({ by: ['category'], _count: true })
console.log('CATEGORIES:', cats.map(c => `${c.category}:${c._count}`).join(', '))
const courses = await db.course.findMany({ select: { title: true, category: true, price: true, coverUrl: true, _count: { select: { lessons: true } } } })
console.log('COURSES:', courses.length)
for (const c of courses) console.log(`- ${c.title} [${c.category}] R$${c.price} lessons:${c._count.lessons} cover:${c.coverUrl ? 'SIM' : 'NÃO'}`)
const lib = await db.libraryItem.findMany({ select: { kind: true, title: true, coverUrl: true, content: true, pdfUrl: true } })
console.log('LIBRARY:', lib.length)
for (const l of lib) console.log(`- [${l.kind}] ${l.title} cover:${l.coverUrl ? 'SIM' : 'NÃO'} content:${l.content ? 'sim' : 'não'} pdf:${l.pdfUrl ? 'sim' : 'não'}`)
process.exit(0)
