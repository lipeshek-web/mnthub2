import { PrismaClient } from '@prisma/client'
const db = new PrismaClient()
const cats = await db.course.groupBy({ by: ['category'], _count: true, orderBy: { _count: { category: 'desc' } } })
console.log('CATEGORIAS DE CURSO:', cats.map(c => `${c.category}:${c._count}`).join(' | '))
const noCover = await db.course.count({ where: { coverUrl: null, isPublished: true } })
const noLessons = await db.course.count({ where: { lessons: { none: {} }, isPublished: true } })
const libNoCover = await db.libraryItem.count({ where: { coverUrl: null, isPublished: true } })
console.log('Cursos sem capa:', noCover, '| Cursos sem aulas:', noLessons, '| Biblioteca sem capa:', libNoCover)
const total = await db.course.count({ where: { isPublished: true } })
const lib = await db.libraryItem.count({ where: { isPublished: true } })
const books = await db.libraryItem.count({ where: { kind: 'BOOK', isPublished: true } })
const mentors = await db.mentorProfile.count({ where: { isPublished: true } })
console.log(`TOTAL: ${mentors} mentores · ${total} cursos · ${lib} itens de biblioteca (${books} livros)`)
// sample new course structure
const c = await db.course.findFirst({ where: { title: { contains: 'Violão' } }, include: { themes: { include: { lessons: { include: { quizzes: true } } } } } })
console.log('SAMPLE Violão:', c?.themes.length, 'temas |', c?.themes.reduce((a, t) => a + t.lessons.length, 0), 'aulas | quizzes:', c?.themes.reduce((a, t) => a + t.lessons.reduce((b, l) => b + l.quizzes.length, 0), 0), '| cover:', c?.coverUrl)
const reader = await db.libraryItem.findFirst({ where: { title: { contains: 'Clean Code' } } })
console.log('SAMPLE Clean Code:', reader?.coverUrl, reader?.pdfUrl)
process.exit(0)
